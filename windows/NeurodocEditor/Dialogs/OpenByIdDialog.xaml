<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NeurodocEditor.Dialogs.OpenByIdDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NeurodocEditor.ViewModels"
    Title="Открыть файл"
    PrimaryButtonText="Открыть"
    CloseButtonText="Отмена"
    DefaultButton="Primary"
    PrimaryButtonClick="OnOpenClick">

    <StackPanel Spacing="12" MinWidth="480">
        <TextBox x:Name="IdBox" Header="UUID или путь к файлу"
                 PlaceholderText="a259b43e-ac17-4167-bf9f-5ff3acf46ba5, root или contract/auth/start.yaml"
                 FontFamily="Consolas"
                 TextChanged="OnIdChanged" />

        <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False" />

        <TextBlock x:Name="ListHeader" Text="Файлы проекта" FontWeight="SemiBold" FontSize="13" />

        <ListView x:Name="MatchList" MaxHeight="240" SelectionMode="Single"
                  SelectionChanged="OnMatchSelected" DoubleTapped="OnMatchDoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BacklinkVM">
                    <StackPanel Padding="0,6">
                        <TextBlock Text="{x:Bind Title}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Id}" FontSize="10" FontFamily="Consolas"
                                   Foreground="{ThemeResource DimTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
