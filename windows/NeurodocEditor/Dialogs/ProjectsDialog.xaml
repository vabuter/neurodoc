<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NeurodocEditor.Dialogs.ProjectsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NeurodocEditor.ViewModels"
    Title="Проекты"
    PrimaryButtonText="Открыть"
    CloseButtonText="Закрыть"
    DefaultButton="Primary"
    PrimaryButtonClick="OnOpenClick">

    <Grid MinWidth="480">
        <StackPanel x:Name="ListPane" Spacing="12">
            <TextBlock Text="Проект — это название и путь к каталогу с neurodoc-документацией."
                       FontSize="12" Foreground="{ThemeResource DimTextBrush}" TextWrapping="Wrap" />

            <ListView x:Name="ProjectList" MaxHeight="300" SelectionMode="Single"
                      SelectionChanged="OnSelectionChanged" DoubleTapped="OnItemDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectItemVM">
                        <Grid Padding="0,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Path}" FontSize="11"
                                           Foreground="{ThemeResource DimTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Visibility="{x:Bind CurrentBadgeVisibility}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="9" Padding="9,3" VerticalAlignment="Center">
                                <TextBlock Text="текущий" FontSize="11"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="NoProjectsText" Text="Список проектов пуст. Добавьте первый проект."
                       FontSize="12" Foreground="{ThemeResource DimTextBrush}" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnAddClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="Добавить" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Content="Изменить" Click="OnEditClick" />
                <Button x:Name="DeleteButton" Content="Удалить">
                    <Button.Flyout>
                        <Flyout x:Name="DeleteFlyout" Placement="Bottom">
                            <StackPanel Spacing="10" MaxWidth="280">
                                <TextBlock Text="Удалить проект из списка? Файлы на диске не удаляются."
                                           TextWrapping="Wrap" FontSize="13" />
                                <Button Content="Удалить" Click="OnDeleteConfirm"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="EditPane" Spacing="12" Visibility="Collapsed" MinWidth="480">
            <TextBlock x:Name="EditPaneTitle" FontWeight="SemiBold" FontSize="15" />
            <TextBox x:Name="NameBox" Header="Название" PlaceholderText="Например: Fikus" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Header="Путь к каталогу"
                         PlaceholderText="C:\путь\к\каталогу" />
                <Button Grid.Column="1" Content="Обзор…" VerticalAlignment="Bottom" Click="OnBrowseClick" />
            </Grid>
            <TextBlock Text="Если каталога нет, он будет создан вместе с файлом root, папкой content и ReadMe.md."
                       FontSize="12" Foreground="{ThemeResource DimTextBrush}" TextWrapping="Wrap" />
            <InfoBar x:Name="EditError" Severity="Error" IsClosable="False" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Click="OnSaveEditClick" />
                <Button Content="Отмена" Click="OnCancelEditClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
