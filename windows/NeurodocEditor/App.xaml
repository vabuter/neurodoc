<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NeurodocEditor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#17000000" />
                    <SolidColorBrush x:Key="DimTextBrush" Color="#8C000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <!-- Тёмная тема: очень тёмный графит; почти непрозрачный слой поверх Mica -->
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2111111" />
                    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#0BFFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="DimTextBrush" Color="#8CFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ToolIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
